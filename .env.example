# Copiar a .env y rellenar. NUNCA commitear .env.
#
# Este mismo fichero sirve para los dos modos de arranque:
#   - local  : la API corre en tu maquina y habla con tu MySQL/Redis
#   - Docker : `docker compose up --build` (T-004)
# En Docker, DATABASE_URL, REDIS_URL, STORAGE_PATH, HOST y PORT los fija
# docker-compose.yml, no este fichero: dentro de la red de compose los servicios
# se llaman `mysql` y `redis`, no `localhost`.

DATABASE_URL=mysql://tcg:cambiame@localhost:3306/proyecto_tcg
REDIS_URL=redis://localhost:6379

# Obligatoria para la ingesta completa de Pokemon (T-005).
# Sin ella la API responde igual pero con cuota diaria muy inferior.
POKEMONTCG_API_KEY=

# Scryfall EXIGE un User-Agent propio y descriptivo. No usar el de por defecto
# del cliente HTTP: es motivo de bloqueo.
EXTERNAL_USER_AGENT=ProyectoTCG/0.1 (+mailto:cambiame@example.com)

STORAGE_PATH=./storage/cards
# El servidor SE NIEGA A ARRANCAR si este secreto esta vacio, tiene menos de 32
# caracteres o es uno de los valores de ejemplo (incluido "cambiame"). No es
# celo: quien conozca el secreto puede firmar un token para cualquier usuario.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Solo Docker Compose -----------------------------------------------------
# Credenciales con las que la imagen de MySQL crea la base y el usuario.
# Si las cambias despues del primer arranque no tienen efecto: el volumen
# db_data ya esta inicializado. Habria que borrarlo (docker compose down -v).
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=proyecto_tcg
MYSQL_USER=tcg
MYSQL_PASSWORD=cambiame

# Puertos publicados en el host. MySQL sale por 3307 y no por 3306 porque la
# maquina de desarrollo suele tener ya un MySQL propio ocupando el 3306.
MYSQL_PORT=3307
REDIS_PORT=6379
API_PORT=3000
WEB_PORT=5173
