# Copiar a .env y rellenar. NUNCA commitear .env.

DATABASE_URL=mysql://tcg:cambiame@localhost:3306/proyecto_tcg
REDIS_URL=redis://localhost:6379

# Obligatoria para la ingesta completa de Pokemon (T-005).
# Sin ella la API responde igual pero con cuota diaria muy inferior.
POKEMONTCG_API_KEY=

# Scryfall EXIGE un User-Agent propio y descriptivo. No usar el de por defecto
# del cliente HTTP: es motivo de bloqueo.
EXTERNAL_USER_AGENT=ProyectoTCG/0.1 (+mailto:cambiame@example.com)

STORAGE_PATH=./storage/cards
# El servidor SE NIEGA A ARRANCAR si este secreto esta vacio, tiene menos de 32
# caracteres o es uno de los valores de ejemplo (incluido "cambiame"). No es
# celo: quien conozca el secreto puede firmar un token para cualquier usuario.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
